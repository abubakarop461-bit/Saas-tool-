{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saas-tool",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": ".next",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saas-tool-db",
      "database_id": "local-saas-tool-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "saas-tool-storage"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
